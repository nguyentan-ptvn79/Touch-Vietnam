APP_NAME=Touch! Việt Nam
APP_ENV=production
APP_VERSION=1.1.0
# Optional: absolute directory for runtime database and logs (defaults to ./data).
# APP_DATA_DIR=
APP_SECRET_KEY=replace_with_a_real_secret_key
APP_DEBUG=false
ENFORCE_HTTPS=true
ENABLE_API_DOCS=false
AUTH_TOKEN_TTL_SECONDS=43200
AUTH_TOKEN_AUDIENCE=touch-vietnam-clients
SESSION_IDLE_TIMEOUT_SECONDS=1800
SESSION_ABSOLUTE_TIMEOUT_SECONDS=28800
SEED_DEMO_USERS=false
DEMO_ADMIN_FULL_NAME=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
ADMIN_EMAILS=admin@touchvn.com
TRUSTED_PROXY_IPS=
CORS_ALLOWED_ORIGINS=
APP_LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_PUBLIC_BASE_URL=https://your-domain.example
MAX_IMAGE_PIXELS=24000000
SECURITY_ALERT_WINDOW_SECONDS=300
SECURITY_ALERT_FAILURE_THRESHOLD=5
SUPPORT_EMAIL=support@touchvn.com
SUPPORT_PHONE=+84 1900 6868
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CHAT_MODEL=gpt-5.6-sol
OPENAI_PLANNER_MODEL=gpt-5.6-sol
GOOGLE_MAPS_EMBED_API_KEY=your_google_maps_embed_api_key_here
INTEGRATION_TIMEOUT_SECONDS=8
EXTERNAL_TICKET_API_BASE_URL=
EXTERNAL_TICKET_API_KEY=
EXTERNAL_TICKET_SEARCH_PATH=/search
EXTERNAL_TICKET_HEALTH_PATH=/health
EXTERNAL_ANALYTICS_API_BASE_URL=
EXTERNAL_ANALYTICS_API_KEY=
EXTERNAL_ANALYTICS_EVENTS_PATH=/events
EXTERNAL_ANALYTICS_HEALTH_PATH=/health
EXTERNAL_AR_API_BASE_URL=
EXTERNAL_AR_API_KEY=
EXTERNAL_AR_LANDMARKS_PATH=/landmarks
EXTERNAL_AR_PLACE_PATH=/places/{place_id}
EXTERNAL_AR_HEALTH_PATH=/health
EXTERNAL_OFFLINE_MAP_API_BASE_URL=
EXTERNAL_OFFLINE_MAP_API_KEY=
EXTERNAL_OFFLINE_MAP_PACKS_PATH=/packs
EXTERNAL_OFFLINE_MAP_HEALTH_PATH=/health
EXTERNAL_WEATHER_API_BASE_URL=
EXTERNAL_WEATHER_API_KEY=
EXTERNAL_WEATHER_FORECAST_PATH=/forecast
EXTERNAL_WEATHER_HEALTH_PATH=/health
EXTERNAL_NEARBY_API_BASE_URL=
EXTERNAL_NEARBY_API_KEY=
EXTERNAL_NEARBY_SEARCH_PATH=/search
EXTERNAL_NEARBY_HEALTH_PATH=/health
